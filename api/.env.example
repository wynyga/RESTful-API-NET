# Copy to .env (git-ignored) and replace every value.
# Generate secrets with:  openssl rand -base64 48

# JWT: the secret must be at least 32 characters.
JwtSettings__Secret=replace-with-a-long-random-secret-of-32-chars-or-more
JwtSettings__Issuer=ProjectTracker
JwtSettings__Audience=ProjectTrackerUsers
JwtSettings__ExpirationInMinutes=60

# Salt for obfuscating ids in URLs (at least 8 characters). No default on purpose.
HASHIDS_SALT=replace-with-a-random-salt

# Browser origins allowed to call the API (comma separated). Empty means same-origin only.
Cors__Origins=http://localhost:3002

# Optional start-up data
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=change-me
# SEED_SAMPLE_DATA=true
# Database__AutoMigrate=true
