# Used by docker-compose.yml. Copy to .env (git-ignored) and replace every value.
# Generate secrets with:  openssl rand -base64 48

MYSQL_ROOT_PASSWORD=change-me
JWT_SECRET=replace-with-a-long-random-secret-of-32-chars-or-more
HASHIDS_SALT=replace-with-a-random-salt

# The first Admin account, created on startup if it does not exist yet.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me

# Optional
# SEED_SAMPLE_DATA=true
# API_PORT=5104
# CORS_ORIGINS=http://localhost:3002
